{
  "name": "oro-functions-client",
  "version": "2.3.6",
  "description": "Ofn contains utility static methods (helpers): General, Numbers, Strings, Functions, Objects, Arrays, Dates, URLs, Files, PHP Serialize, and Response.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage",
    "coverage:open": "node coverage.open.js",
    "coverage-open": "jest --coverage && node coverage.open.js",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "clean": "rm -Rf ./dist",
    "clean:all": "rm -Rf ./dist ./node_modules ./coverage",
    "check:all": "npm run lint && npm run build && npm run coverage",
    "update:deps": "node update-deps.js",
    "build": "tsup",
    "watch": "nodemon"
  },
  "keywords": [
    "constant",
    "functions",
    "helpers",
    "typescript"
  ],
  "author": "Carlos Oropesa <carlos@oropensando.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oropesa/oro-functions-client.git"
  },
  "bugs": {
    "url": "https://github.com/oropesa/oro-functions-client/issues"
  },
  "homepage": "https://github.com/oropesa/oro-functions-client#readme",
  "dependencies": {
    "crypto-js": "^4.2.0",
    "js-base64": "^3.7.8",
    "lodash.clonedeep": "^4.5.0",
    "oro-php-locutus": "^2.1.7",
    "oro-regexp": "^2.1.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.38.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "babel-jest": "^30.2.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
